# Server-only settings. Never copy these into frontend/.env.
NODE_ENV=development
PORT=4000

# Neon supplies this PostgreSQL connection string in the Connect dialog.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# SES sender identity must be verified in this AWS region.
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional when using temporary AWS credentials.
AWS_SESSION_TOKEN=
SES_FROM_EMAIL=newsletter@blog.derivionacademy.in
# Display name shown as the sender in recipients' inboxes.
SES_FROM_NAME=ISFT
# Optional SES configuration set.
SES_CONFIGURATION_SET=

# Public frontend/API addresses.
NEWSLETTER_SITE_URL=https://your-frontend-domain.example
NEWSLETTER_API_PUBLIC_URL=https://your-newsletter-api-domain.example
ALLOWED_ORIGINS=https://your-frontend-domain.example,http://localhost:3000

# Generate both with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
NEWSLETTER_TOKEN_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
NEWSLETTER_ADMIN_TOKEN=replace-with-a-separate-random-admin-token

# Poll send_at once a minute; actual send time is stored per newsletter in PostgreSQL.
NEWSLETTER_CRON_SCHEDULE=* * * * *
NEWSLETTER_BATCH_SIZE=50
NEWSLETTER_SEND_CONCURRENCY=5
NEWSLETTER_STALE_SEND_MINUTES=30

# Render automatically trusts its single proxy when RENDER_EXTERNAL_URL is set.
# Set this to the exact trusted proxy hop count for other deployments; keep 0 locally.
TRUST_PROXY_HOPS=0

# Optional named AWS CLI profile is not used by the running Express server.
# AWS_PROFILE=default

# Market snapshot for the article sidebar (daily SnapData values stored in PostgreSQL).
# Comma-separated 24-hour HH:MM times in MARKET_SNAPSHOT_TIMEZONE. Leave empty to disable
# scheduled refreshes; no production times are assumed. Example: 08:30,20:30
MARKET_SNAPSHOT_TIMES=
MARKET_SNAPSHOT_TIMEZONE=Asia/Kolkata
# Cron day-of-week field: * for every day, 1-5 for Monday to Friday.
MARKET_SNAPSHOT_DAYS=*
# Per-source request timeout in milliseconds (max 60000).
MARKET_SNAPSHOT_TIMEOUT_MS=10000
# Hours after the last successful refresh before the sidebar shows values as stale.
# Defaults to 36, or 84 when MARKET_SNAPSHOT_DAYS is restricted (covers weekends).
MARKET_SNAPSHOT_STALE_AFTER_HOURS=
# Skip a scheduled refresh if another one started within this many minutes (multi-instance guard).
MARKET_SNAPSHOT_MIN_INTERVAL_MINUTES=10
# Populate an empty snapshot table once at startup; never refreshes existing values.
MARKET_SNAPSHOT_BOOTSTRAP_IF_EMPTY=true

# Automated News & Insights import from Gmail (separate from the newsletter features above).
# Checks run every AUTO_NEWS_CHECK_INTERVAL_MINUTES inside 13:00-13:59 and 16:00-16:59
# Asia/Kolkata, Sunday to Friday (never Saturday). Keep disabled until Gmail and Cloudinary are set up.
AUTO_NEWS_ENABLED=false
# Keep false for the first test: imports are stored as drafts. Preview, publish, then set true.
AUTO_NEWS_AUTO_PUBLISH=false
AUTO_NEWS_SENDER=neil.crammond@zenithwavecapital.com
# Require Gmail's own DKIM/DMARC pass for the sender's domain (blocks spoofed From headers).
AUTO_NEWS_REQUIRE_SENDER_AUTH=true
# Exact extra DKIM domains (no wildcards), e.g. the sender's Google Workspace default key
# <sender-domain-with-dashes>.<digits>.gappssmtp.com, taken from a verified email's headers.
AUTO_NEWS_TRUSTED_DKIM_DOMAINS=
# Bearer token for POST /api/auto-news/import. Required when enabled. Generate with:
# node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
AUTO_NEWS_IMPORT_TOKEN=
AUTO_NEWS_CHECK_INTERVAL_MINUTES=10
# How far back each check searches Gmail (days, max 30).
AUTO_NEWS_LOOKBACK_DAYS=3
# Failed imports (e.g. Cloudinary outage) are retried on later checks up to this many times.
AUTO_NEWS_MAX_ATTEMPTS=5
AUTO_NEWS_CLOUDINARY_FOLDER=derivion/auto-news

# Gmail API OAuth client (scope https://www.googleapis.com/auth/gmail.readonly).
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_USER=me

# Cloudinary credentials: either CLOUDINARY_URL or the three separate values.
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
