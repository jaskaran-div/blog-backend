# Server-only settings. Never copy these into frontend/.env.
NODE_ENV=development
PORT=4000

# Use the PostgreSQL connection string shown for your Supabase project.
# The Supabase database region is independent of the AWS SES region.
DATABASE_URL=postgresql://postgres.your-project-ref:replace-with-db-password@your-supabase-pooler-host:6543/postgres?sslmode=require
DATABASE_SSL=true

# SES sender identity must be verified in this AWS region.
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional when using temporary AWS credentials.
AWS_SESSION_TOKEN=
SES_FROM_EMAIL=newsletter@blog.derivionacademy.in
# Optional SES configuration set.
SES_CONFIGURATION_SET=

# Public frontend/API addresses. Point the API URL at the public Express deployment.
NEWSLETTER_SITE_URL=https://blog.derivionacademy.in
NEWSLETTER_API_PUBLIC_URL=https://your-newsletter-api-domain.example
ALLOWED_ORIGINS=https://blog.derivionacademy.in,http://localhost:3000

# Generate both with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
NEWSLETTER_TOKEN_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
NEWSLETTER_ADMIN_TOKEN=replace-with-a-separate-random-admin-token

# Poll send_at once a minute; actual send time is stored per newsletter in PostgreSQL.
NEWSLETTER_CRON_SCHEDULE=* * * * *
NEWSLETTER_BATCH_SIZE=50
NEWSLETTER_SEND_CONCURRENCY=5
NEWSLETTER_STALE_SEND_MINUTES=30

# Set to the number of trusted proxy hops only when behind a reverse proxy.
TRUST_PROXY_HOPS=0

# Optional named AWS CLI profile is not used by the running Express server.
# AWS_PROFILE=default
